OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o

# GREEN-API console -> your instance: apiUrl, mediaUrl, idInstance, apiTokenInstance
GREENAPI_URL=https://7103.api.greenapi.com
GREENAPI_MEDIA_URL=https://7103.media.greenapi.com
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=

# WhatsApp chat that receives handoffs (staff phone number without +)
STAFF_CHAT_ID=37477000000@c.us

# Same value as "webhookUrlToken" in the GREEN-API instance settings
WEBHOOK_SECRET=change-me

# Optional: answer only these chats ("*" or empty = everyone, "none" = nobody)
ALLOWED_CHAT_IDS=37491000000,37455000000
# Optional: also forward every webhook (with the same Authorization header) to another service, e.g. a CRM
FORWARD_WEBHOOK_URL=
